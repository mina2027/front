VITE_API_BASE=
VITE_API_PROXY_TARGET=http://localhost:4000

# Firebase (Phone Auth / SMS OTP). Copy the values from your EXISTING Firebase
# project: Firebase console → Project settings → "Your apps" → SDK setup → Config.
# Phone verification is disabled gracefully until these are set (existing
# email/password registration keeps working without them).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
